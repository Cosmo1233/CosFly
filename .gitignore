# ESP-IDF build output (regenerated by idf.py build)
build/

# Downloaded by the IDF component manager from dependencies.lock
managed_components/

# menuconfig backup
sdkconfig.old

# Stray build directory (idf.py -B bchk)
bchk/

# Board test: generated from tools/board_test/sdkconfig.defaults
tools/board_test/sdkconfig

# Altium: local backups, regenerated previews and ECO logs (Git is the history)
hardware/**/History/
hardware/**/__Previews/
hardware/**/Project Logs for */
*.SchDocPreview
*.$$$Preview
*.LOG
