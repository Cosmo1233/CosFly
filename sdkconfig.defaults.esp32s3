CONFIG_FREERTOS_UNICORE=n
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_MHZ=240

# ---------------------------------------------------------------------------
# CosFly V1 board pin map
#
# LiteWing/ESP-Drone defaults target a different board. Everything below is
# the CosFly V1 schematic. Format is "was -> is" so the delta stays readable.
# ---------------------------------------------------------------------------

# Motors (brushed). Numeric order here is NOT verified against physical arms
# yet -- see step 2 of the port (spin each motor with props off).
# M1 LeftUp, M2 RightUp, M3 RightDown, M4 LeftDown per schematic labels.
# M2 is chip pin 48 (MTMS) = GPIO42 per the schematic netlist. GPIO41 (pin 47)
# is E_TX2 on the breakout header.
CONFIG_MOTOR01_PIN=2
CONFIG_MOTOR02_PIN=42
CONFIG_MOTOR03_PIN=7
CONFIG_MOTOR04_PIN=8

# SPI -- BMI270 IMU lives here on CosFly (LiteWing had the IMU on I2C0 and
# used this bus for a PMW3901 flow deck).
CONFIG_SPI_PIN_MISO=37
CONFIG_SPI_PIN_MOSI=38
CONFIG_SPI_PIN_CLK=39
CONFIG_SPI_PIN_CS0=40

# I2C0 = "sensors bus" (i2cdev I2C0_DEV), CosFly's single internal I2C bus
# (schematic: INT_SDA/INT_SCL). BMP280 baro, BMM150 mag, config-block EEPROM,
# and the PCA GPIO expander are all wired to it, so configblockeeprom.c and
# pca9555.c/pca95x4.c were repointed from I2C1_DEV to I2C0_DEV to match.
CONFIG_I2C0_PIN_SDA=33
CONFIG_I2C0_PIN_SCL=34

# I2C1 = "deck bus" (i2cdev I2C1_DEV). Nothing on CosFly V1 uses it -- the
# EEPROM/expander were moved to I2C0 above. Only the (unused, no deck present)
# VL53L0/VL53L1 ToF flow-deck drivers still reference I2C1_DEV, so these pins
# are just harmless placeholders, not a real bus.
CONFIG_I2C1_PIN_SDA=14
CONFIG_I2C1_PIN_SCL=15

# Battery sense: chip pin 9 = GPIO4 (ADC1_CH3), behind a 200k/100k divider
# (R15/R18) so VBAT = 3 x Vadc. GPIO3 is only a strapping pin with a pull-up.
CONFIG_ADC1_PIN=4

# BMI270 INT1/INT2. These are NOT split accel/gyro -- every interrupt source
# (data ready, FIFO, error, features) can be mapped to either pin in software
# (INT_MAP_DATA 0x58, INT1/2_MAP_FEAT 0x56/0x57). Both have 4.7k pull-ups
# (R27/R29), so they are configured active-low open-drain. Data-ready is
# mapped to INT1; INT2 is spare for error/feature interrupts.
# MPU_PIN_INT is the existing LiteWing name, reused here for INT1.
CONFIG_MPU_PIN_INT=36
CONFIG_IMU_PIN_INT2=35

# LEDs on CosFly sit behind the PCA9534A I2C expander (U3, A2..A0 = GND ->
# 0x38), not on direct GPIOs. With LED_VIA_PCA9534 set, led_esp32.c drives
# expander pins P1/P2/P3 and never touches the LED_PIN_* GPIOs below.
CONFIG_LED_VIA_PCA9534=y
CONFIG_LED_PCA9534_ADDR=0x38

# Unused while LED_VIA_PCA9534=y. Kept off the motor pins (LiteWing's 7/8)
# in case the option is ever turned off. Note 9/10/11 are E_RX1/E_SDA/E_TX1
# on the breakout header.
CONFIG_LED_PIN_BLUE=9
CONFIG_LED_PIN_GREEN=10
CONFIG_LED_PIN_RED=11

# No buzzer on CosFly, and the buzzer pins (39/38) are now SPI CLK/MOSI.
# buzzerInit() is #ifdef'd on this, so =n keeps it off those pins.
CONFIG_BUZZER_ON=n
